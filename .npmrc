# @pascal-app/editor declares a peer dependency on `next` (it's published as a
# Next.js library), but this is a Vite app — we shim next/image and next/link
# in vite.config.ts instead of installing Next. legacy-peer-deps keeps npm from
# trying to auto-install Next (and from failing `npm ci` on the peer conflict),
# so local installs and CI/Cloudflare builds resolve the same tree as the lockfile.
legacy-peer-deps=true
